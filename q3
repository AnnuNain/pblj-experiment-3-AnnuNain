//Develop a ticket booking system with synchronized threads to ensure no
double booking of seats. Use thread priorities to simulate VIP bookings being
processed first.

import java.util.*;

class SeatBookingSystem {
    private static final int TOTAL_SEATS = 10;
    private static final boolean[] seats = new boolean[TOTAL_SEATS];

    public synchronized boolean reserveSeat(int seatNumber, String customer) {
        if (seatNumber < 0 || seatNumber >= TOTAL_SEATS) {
            System.out.println(customer + " attempted to reserve an invalid seat.");
            return false;
        }
        if (!seats[seatNumber]) {
            seats[seatNumber] = true;
            System.out.println(customer + " successfully reserved seat " + seatNumber);
            return true;
        } else {
            System.out.println(customer + " attempted to reserve an already occupied seat " + seatNumber);
            return false;
        }
    }
}

class ReservationThread extends Thread {
    private final SeatBookingSystem system;
    private final int seatNumber;
    private final String customer;

    public ReservationThread(SeatBookingSystem system, int seatNumber, String customer, int priority) {
        this.system = system;
        this.seatNumber = seatNumber;
        this.customer = customer;
        setPriority(priority);
    }

    @Override
    public void run() {
        system.reserveSeat(seatNumber, customer);
    }
}

public class SeatBookingMain {
    public static void main(String[] args) {
        SeatBookingSystem system = new SeatBookingSystem();
        List<Thread> threads = new ArrayList<>();

        threads.add(new ReservationThread(system, 3, "VIP_1", Thread.MAX_PRIORITY));
        threads.add(new ReservationThread(system, 3, "User_1", Thread.NORM_PRIORITY));
        threads.add(new ReservationThread(system, 5, "VIP_2", Thread.MAX_PRIORITY));
        threads.add(new ReservationThread(system, 5, "User_2", Thread.NORM_PRIORITY));
        threads.add(new ReservationThread(system, 7, "User_3", Thread.MIN_PRIORITY));

        for (Thread thread : threads) {
            thread.start();
        }
        
        for (Thread thread : threads) {
            try {
                thread.join();
            } catch (InterruptedException e) {
                e.printStackTrace();
            }
        }
    }
}
